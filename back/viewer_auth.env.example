# Copy to back/viewer_auth.env and fill in from Google Cloud Console >
# APIs & Services > Credentials > your OAuth client. Never commit the real file.

YT_VIEWER_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
YT_VIEWER_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# openid is what makes userinfo return `sub`, and `sub` is the key the journal is
# filed under - without it there is no identity to bind anything to. List both.
# Anything you put here is *added* to the required scopes rather than replacing
# them, so an incomplete value cannot quietly drop openid.
YT_VIEWER_SCOPE=openid https://www.googleapis.com/auth/youtube
