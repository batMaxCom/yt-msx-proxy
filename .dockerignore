node_modules
.git
logs
.DS_Store
.idea
*.log
/tmp

# Runtime state. `COPY . .` would otherwise bake whatever happens to be on the
# build host into the image, and the running container would then write over its
# own layer. These come back through the named volumes in docker-compose.yml.
# back/token holds OAuth tokens, which must never end up in an image layer.
# settings.json is bind-mounted from the host (it is a file, not a directory);
# without a bind mount the server recreates it with serverIp = localhost.
/back/history/
/back/token/
/back/imgcache/
/back/logs/
/back/streams/
/back/settings.json

# Viewer sign-in secrets. .gitignore keeps these out of git, but `COPY . .` reads
# the build context directly and ignores git - so without this line the client
# secret lands in an image layer. It is injected at run time instead.
/back/viewer_auth.env
/back/accounts/
